# n8n & Traefik Environment Configuration
# Ad-to-Sale Attribution System

# Primary Domain Configuration
DOMAIN_NAME=homecartel.ph
SUBDOMAIN=n8n
SSL_EMAIL=admin@homecartel.ph

# Timezone (Philippines Standard Time)
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# Zendesk Credentials (Optional, or configure directly inside n8n Credentials Manager)
ZD_SUBDOMAIN=homecartelhelp
ZD_EMAIL=admin@homecartel.ph
ZD_TOKEN=your_zendesk_api_token_here

# Meta Conversions API (CAPI) Credentials
META_DATASET_ID=your_meta_dataset_id_here
META_ACCESS_TOKEN=your_meta_capi_access_token_here
META_TEST_EVENT_CODE=

# Zoho Books Credentials
ZOHO_ORG_ID=your_zoho_organization_id
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_WEBHOOK_SECRET=your_secret_token_12_50_chars

META_DATASET_ID=your_meta_dataset_id_here
META_ACCESS_TOKEN=your_meta_capi_access_token_here
META_TEST_EVENT_CODE=
META_AD_ACCOUNT_ID=your_meta_ad_account_id_here

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
ALERT_RECIPIENTS=ops@homecartel.ph
DAILY_AUDIT_TIME=08:00
APP_TIMEZONE=Asia/Manila

ZD_FIELD_UTM_MEDIUM=
ZD_FIELD_UTM_CONTENT=
ZD_FIELD_ATTRIBUTION_CONFIDENCE=
