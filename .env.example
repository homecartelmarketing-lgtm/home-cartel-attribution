# ==========================================
# Ad-to-Sale Attribution System Environment Template
# ==========================================

# Server Configuration
SERVER_HOST=0.0.0.0
PORT=8000

# Zendesk Configuration
ZD_SUBDOMAIN=homecartelhelp
ZD_EMAIL=your-email@homecartel.ph
ZD_TOKEN=your-zendesk-api-token

# Zendesk Custom Ticket Field IDs
ZD_FIELD_SESSION_TOKEN=17953452223503
ZD_FIELD_FBCLID=17953492031119
ZD_FIELD_UTM_CAMPAIGN=17953470092687
ZD_FIELD_UTM_SOURCE=17953470454671
ZD_FIELD_CONTACT_CHANNEL=17953481428751

# Meta Conversions API (CAPI) Configuration
META_DATASET_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Zoho Creator Configuration
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=your-refresh-token
ZOHO_CREATOR_ACCOUNT=homecartel
ZOHO_CREATOR_APP=cms
ZOHO_CREATOR_PAGE=Sales_Orders1

# Dashboard Login (JWT cookie — generate hash via: python scripts/make_password_hash.py)
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste-generated-pbkdf2-hash-here
AUTH_SECRET_KEY=generate-64-char-random-string-here
TOKEN_EXPIRE_MINUTES=720

# CORS allow-list (comma-separated; never use * with credentials)
CORS_ORIGINS=https://home-cartel.myshopify.com,https://dear-dining.myshopify.com,https://home22shop.myshopify.com,https://homecartel.net
